{
  "name": "face-crop-forge",
  "version": "1.7.0",
  "description": "Face detection and cropping tool using MediaPipe",
  "type": "module",
  "scripts": {
    "dev": "trunk serve",
    "build": "trunk build --release",
    "check": "cargo check --target wasm32-unknown-unknown",
    "fmt": "cargo fmt",
    "lint": "cargo clippy --target wasm32-unknown-unknown -- -D warnings",
    "test": "cargo test",
    "clean": "cargo clean"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "rimraf": "^6.0.1",
    "typescript": "^5.3.0"
  },
  "keywords": [
    "face-detection",
    "mediapipe",
    "image-processing",
    "crop"
  ],
  "author": "https://github.com/gregorycarnegie/",
  "license": "AGPL-3.0"
}
